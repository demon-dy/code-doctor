{
  "name": "@thunder-doctor/code-doctor",
  "version": "0.3.0",
  "description": "AI 业务代码审计系统：生成可追溯业务地图，用自然语言需求检查真实代码行为",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demon-dy/code-doctor.git"
  },
  "homepage": "https://github.com/demon-dy/code-doctor#readme",
  "bugs": "https://github.com/demon-dy/code-doctor/issues",
  "license": "MIT",
  "type": "module",
  "bin": {
    "code-doctor": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "release": "npm run check && npm publish --access public --registry=https://registry.npmjs.org",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "minimatch": "^10.2.4",
    "picocolors": "^1.1.1",
    "typescript": "^6.0.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
